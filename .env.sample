# ---- Watchbridge configuration ----
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8080
# Public origin users hit; used for OAuth redirect URLs and email links.
APP_URL=http://localhost:8080

# Persistence. Default is embedded PGlite (no external DB needed).
# For production Postgres: postgres://user:pass@host:5432/watchbridge
DATABASE_URL=pglite://./data/pg
# REDIS_URL=redis://localhost:6379

# Secrets — generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# openssl rand -base64 48
SESSION_SECRET=

# Real client IP behind a proxy. Keywords: cloudflare, loopback, private.
# Behind Cloudflare set: TRUSTED_PROXIES=cloudflare
TRUSTED_PROXIES=
TRUST_CLOUDFLARE_HEADER=true

# Registration / abuse controls
REGISTRATION_ENABLED=true
SIGNUP_RATE_PER_HOUR=10
MAX_CONCURRENT_SYNCS_GLOBAL=4
MAX_CONCURRENT_SYNCS_PER_USER=1
MIN_SCHEDULE_INTERVAL_MINUTES=15

# Transactional email via Resend (https://resend.com). Create an API key in the
# Resend dashboard and verify your sending domain. Without a key, emails are
# logged instead of sent (dev only).
RESEND_API_KEY=
MAIL_FROM=Watchbridge <no-reply@example.com>

# Providers — register apps and paste credentials.
# Trakt: https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Simkl: https://simkl.com/settings/developer/
# V1 (legacy, retiring ~April 2027). Used by new connections while
# SIMKL_AUTH_VERSION=v1, and by existing V1 connections until they reconnect.
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# V2 (OAuth 2.0 + PKCE + refresh tokens). Set SIMKL_AUTH_VERSION=v2 to make new
# connections use V2, and fill in the V2 app credentials.
SIMKL_AUTH_VERSION=v1
SIMKL_V2_CLIENT_ID=
SIMKL_V2_CLIENT_SECRET=
APP_NAME=Watchbridge
APP_VERSION=0.1.0

# Log verbosity: trace, debug, info, warn, error, fatal. Defaults to info.
# debug adds per-item detail on the hot paths.
LOG_LEVEL=info

# How often a scheduled sync ignores its saved delta cursor and re-reads the
# source in full, so a cursor that silently stopped advancing self-heals.
# Default 168 (weekly); 0 disables it.
#
# Note: a reconcile re-reads the whole library WITH the per-episode flags, which
# is the "heavy pull" Simkl's docs say to reserve for the one-time baseline —
# `date_from` accepts any age, so a delta never needs a full re-read to be safe.
# This timer is a deliberate self-heal for a stuck cursor; set to 0 if you would
# rather rely on the delta path alone.
FULL_RECONCILE_INTERVAL_HOURS=168

# Daily cap on sync-alert emails, so a provider outage can't burn through the
# Resend daily quota in one burst. Default 50; 0 disables the cap.
MAX_ALERT_EMAILS_PER_DAY=50
